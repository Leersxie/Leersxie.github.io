---
/**
 * AnalyticsScripts.astro
 * 第三方分析脚本组件 - 延迟加载优化
 *
 * 包含:
 * - Google Tag Manager (GTM)
 * - Microsoft Clarity (可选，通过 thirdPartyAnalytics 配置控制)
 *
 * 使用 requestIdleCallback 延迟加载以优化性能
 */

import { siteConfig } from "@/config";
import type { ThirdPartyAnalyticsConfig } from "@/types/config";

interface Props {
	thirdPartyAnalytics?: ThirdPartyAnalyticsConfig;
}

const {
	thirdPartyAnalytics = siteConfig.thirdPartyAnalytics ?? { enable: false },
} = Astro.props;

// GTM：此前容器 ID 硬编码为默认参数，无论配置如何都会被加载。
// 现在完全由 siteConfig.thirdPartyAnalytics.gtm 控制。
const gtmId = thirdPartyAnalytics.gtm?.id ?? "";
const gtmEnable = Boolean(thirdPartyAnalytics.gtm?.enable && gtmId);

// Clarity：独立开关
const clarityId = thirdPartyAnalytics.clarityId || "";
const clarityEnable = Boolean(thirdPartyAnalytics.enable && clarityId);

const analyticsEnabled = gtmEnable || clarityEnable;
---

{
	analyticsEnabled && (
		<script
			is:inline
			define:vars={{
				gtmEnable,
				gtmId,
				clarityEnable,
				clarityId,
			}}
		>
			(function () {
				// 标记脚本是否已加载
				window.analyticsLoaded = window.analyticsLoaded || false;

				function loadAnalytics() {
					if (window.analyticsLoaded) {
						return;
					}
					window.analyticsLoaded = true;

					// Google Tag Manager
					if (gtmEnable && gtmId) {
						(function (w, d, s, l, i) {
							w[l] = w[l] || [];
							w[l].push({
								"gtm.start": new Date().getTime(),
								event: "gtm.js",
							});
							const f = d.getElementsByTagName(s)[0],
								j = d.createElement(s);
							j.async = true;
							j.src =
								"https://www.googletagmanager.com/gtm.js?id=" +
								i;
							f.parentNode.insertBefore(j, f);
						})(window, document, "script", "dataLayer", gtmId);
					}

					// Clarity (仅在启用时加载)
					if (clarityEnable && clarityId) {
						(function (c, l, a, r, i, t, y) {
							c[a] =
								c[a] ||
								function () {
									(c[a].q = c[a].q || []).push(arguments);
								};
							t = l.createElement(r);
							t.async = 1;
							t.src = "https://www.clarity.ms/tag/" + i;
							y = l.getElementsByTagName(r)[0];
							y.parentNode.insertBefore(t, y);
						})(window, document, "clarity", "script", clarityId);
					}
				}

				// 仅在用户交互后加载分析脚本，减少初始页面加载负担
				const events = [
					"scroll",
					"mousemove",
					"keydown",
					"touchstart",
					"click",
				];
				let loaded = false;

				function onInteraction() {
					if (loaded) {
						return;
					}
					loaded = true;
					events.forEach(function (event) {
						window.removeEventListener(event, onInteraction);
					});
					loadAnalytics();
				}

				events.forEach(function (event) {
					window.addEventListener(event, onInteraction, {
						once: true,
						passive: true,
					});
				});

				// 备用：如果用户 10 秒内没有交互，则在 idle 时加载
				setTimeout(function () {
					if (!loaded) {
						loadAnalytics();
					}
				}, 10000);
			})();
		</script>
	)
}
