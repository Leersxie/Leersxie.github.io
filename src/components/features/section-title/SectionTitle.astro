---
import type { SectionTitleProps } from "./types";

const {
	title,
	eyebrow,
	count,
	icon,
	class: className = "",
} = Astro.props as SectionTitleProps;
---

<!-- 「标签 + 标题 + 细线」三段式：eyebrow 可选，不传则退化为「标题 + 细线」 -->
<div class:list={["mb-5", className]}>
	{
		eyebrow && (
			<p class="mb-2 flex items-center gap-2 text-[0.7rem] font-semibold tracking-[0.18em] uppercase text-[var(--primary)]/80">
				<span
					class="inline-block h-px w-6 bg-[var(--primary)]/40"
					aria-hidden="true"
				/>
				{eyebrow}
			</p>
		)
	}
	<div class="flex items-center gap-4">
		<h2
			class="text-xl font-bold text-black/90 dark:text-white/90 pl-3 relative min-w-0
				before:left-0 before:top-1/2 before:-translate-y-1/2 before:w-1 before:h-5 before:rounded-full before:bg-[var(--primary)]"
		>
			{icon && <span class={`w-3 h-3 rounded-full ${icon} mr-3`} />}
			{title}
			{
				count !== undefined && (
					<span class="text-sm font-medium text-[var(--primary)]/70 ml-2">
						({count})
					</span>
				)
			}
		</h2>
		<span
			class="h-px min-w-8 flex-1 bg-gradient-to-r from-[var(--line-color)] to-transparent"
			aria-hidden="true"
		/>
	</div>
</div>
