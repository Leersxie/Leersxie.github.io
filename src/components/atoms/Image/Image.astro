---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "eager" | "lazy";
	fetchpriority?: "high" | "low" | "auto";
	widths?: number[];
	sizes?: string;
	/**
	 * 可选：把 <img> 包进 <picture>，并添加一个仅在指定媒体条件下命中的
	 * 1×1 透明占位图。
	 *
	 * 用途：同一位置存在「桌面一套 + 移动一套」两张图、但实际只会展示其中一张时
	 * （如 Banner），用 `display:none` 隐藏并不能阻止 eager 图片被下载，
	 * 只有 <picture> 的媒体查询才能真正避免多余请求。
	 *
	 * 例：placeholderMedia="(min-width: 768px)"
	 *      → 桌面视口下只加载占位图，移动端才加载真实图片。
	 *      未匹配到 media 时浏览器回退到 <img>，行为与原先一致。
	 */
	placeholderMedia?: string;
	/**
	 * 容器是否铺一层微光骨架屏（图片加载完成后被 <img> 自然遮挡）。
	 * 默认关闭，避免影响带透明通道的 logo / 图标。
	 */
	skeleton?: boolean;
}

import { Image as AstroImage } from "astro:assets";

import { url } from "../../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority,
	widths,
	sizes,
	placeholderMedia,
	skeleton = false,
} = Astro.props;
const className = Astro.props.class;

/** 1×1 全透明 GIF，作为不适用视口的占位，不产生任何网络请求 */
const TRANSPARENT_PIXEL =
	"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img: ImageMetadata | undefined;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否是 Bilibili 图片
const isBilibiliImage = !isLocal && src.includes("hdslb.com");
// 对于外部图片（特别是 Bilibili），需要设置 referrerpolicy 避免 403 错误
const referrerPolicy = !isLocal && isBilibiliImage ? "no-referrer" : undefined;
---

<div
	id={id}
	class:list={[
		className,
		"overflow-hidden relative",
		{ "image-skeleton": skeleton },
	]}
>
	<div
		class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"
	>
	</div>
	{
		isLocal && img && (
			<AstroImage
				src={img}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				loading={loading}
				fetchpriority={fetchpriority}
				widths={widths}
				sizes={sizes}
			/>
		)
	}
	{
		!isLocal && placeholderMedia && (
			<picture class="block h-full w-full">
				<source media={placeholderMedia} srcset={TRANSPARENT_PIXEL} />
				<img
					src={isPublic ? url(src) : src}
					alt={alt || ""}
					class={imageClass}
					style={imageStyle}
					loading={loading}
					referrerpolicy={referrerPolicy}
					crossorigin={isBilibiliImage ? "anonymous" : undefined}
					fetchpriority={fetchpriority}
				/>
			</picture>
		)
	}
	{
		!isLocal && !placeholderMedia && (
			<img
				src={isPublic ? url(src) : src}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				loading={loading}
				referrerpolicy={referrerPolicy}
				crossorigin={isBilibiliImage ? "anonymous" : undefined}
				fetchpriority={fetchpriority}
			/>
		)
	}
</div>
